+RenderParagraph? _findRenderParagraph(RenderObject root) {
+  if (root is RenderParagraph) {
+    return root;
+  }
+  RenderParagraph? result;
+  root.visitChildren((child) {
+    result ??= _findRenderParagraph(child);
+  });
+  return result;
+}
