+                    position: event.localPosition,
+                    timestamp: event.timeStamp,
+                    target: GlassPointerTarget.main,
+                  );
+                },
+                onPointerMove: (event) {
+                  if (_pointer == event.pointer) {
+                    motion.movePointer(
+                      position: event.localPosition,
+                      timestamp: event.timeStamp,
+                    );
+                  }
+                },
+                onPointerUp: (event) {
+                  if (_pointer != event.pointer) {
+                    return;
+                  }
+                  final inside = baseRect
+                      .inflate(hitSlop)
+                      .contains(event.localPosition);
+                  motion.endPointer(
+                    position: event.localPosition,
+                    timestamp: event.timeStamp,
+                  );
+                  _pointer = null;
+                  if (inside) {
+                    onTap?.call();
+                  }
+                },
+                onPointerCancel: (event) {
+                  if (_pointer == event.pointer) {
+                    motion.cancelPointer();
+                    _pointer = null;
+                  }
+                },
