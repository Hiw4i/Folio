+                              child: Center(
+                                child: Transform.translate(
+                                  offset: contentOffset,
+                                  child: Transform.scale(
+                                    scale: LiquidContent.scale(motion.press),
+                                    child: widget.child,
+                                  ),
+                                ),
+                              ),
+                            ),
+                            // Single-action glass absorbs behind it on top.
+                            if (interactive) const GlassTouchShield(),
+                          ],
+                        ),
+                      ),
+                    ),
+                  ),
+                ),
+              ),
+            );
+          },
+        ),
+      ),
+    );
